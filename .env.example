# Development uses a random ephemeral signing key if SECRET_KEY is empty.
# Before production: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
SECRET_KEY=
MODEL_DIR=artifacts/ptbxl-resnet1d-v1
MODEL_DEVICE=cpu
MODEL_THREADS=4
DB_PATH=cardioscan.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
